<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.babylog</groupId>
        <artifactId>babylog-plugins</artifactId>
        <version>3.2.0</version>
    </parent>

    <artifactId>babylog-plugin-monitor</artifactId>

    <name>babylog-plugin-monitor</name>
    <description>BabyLog monitor 插件（S48 2.3-F6：服务监控 oshi/JMX/虚拟线程 + 缓存监控 Redis INFO；S83 AI 图表历史）</description>

    <dependencies>
        <!-- 底座 Starter -->
        <dependency>
            <groupId>com.babylog</groupId>
            <artifactId>babylog-starter-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.babylog</groupId>
            <artifactId>babylog-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.babylog</groupId>
            <artifactId>babylog-starter-auth</artifactId>
        </dependency>
        <!-- S83 AI 图表历史落库（mn_ai_chart） -->
        <dependency>
            <groupId>com.babylog</groupId>
            <artifactId>babylog-starter-mybatis</artifactId>
        </dependency>

        <!-- Redisson 客户端（缓存监控 INFO / DBSIZE 采集） -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
        </dependency>

        <!-- oshi 系统/硬件采集（服务监控 CPU/内存/磁盘） -->
        <dependency>
            <groupId>com.github.oshi</groupId>
            <artifactId>oshi-core</artifactId>
        </dependency>

        <!-- S71 运营工作台/数据大屏：跨插件统计契约（只依赖 api 包，符合 ArchUnit A1/A2） -->
        <dependency>
            <groupId>com.babylog</groupId>
            <artifactId>babylog-plugin-system-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.babylog</groupId>
            <artifactId>babylog-plugin-workflow-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.babylog</groupId>
            <artifactId>babylog-plugin-file-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.babylog</groupId>
            <artifactId>babylog-plugin-ai-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.babylog</groupId>
            <artifactId>babylog-plugin-ai-kb-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- ES 监控：搜索健康 SPI 契约（只引 api 包，符合 ArchUnit A1/A2——
             monitor 不得依赖 -es-java / -easy-es 实现模块，指标经 SearchHealthProvider 获取） -->
        <dependency>
            <groupId>com.babylog</groupId>
            <artifactId>babylog-starter-search-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- S130 通用数据监控：只引契约包（零中间件依赖），
             MySQL / Redis / ES 实现由启动器（admin-server）引入，插件侧靠 SPI Bean 获取 -->
        <dependency>
            <groupId>com.babylog</groupId>
            <artifactId>babylog-starter-datainspect-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 测试（纯单元测试：INFO 解析器，无需 Spring 上下文） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
