<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.babylog</groupId>
        <artifactId>babylog-plugins</artifactId>
        <version>2.5.0</version>
    </parent>

    <artifactId>babylog-plugin-biz</artifactId>

    <name>babylog-plugin-biz</name>
    <description>BabyLog 业务插件实现（家庭同步 / 记录 / 基础数据 / 设备 / 反馈 / 版本公告）</description>

    <dependencies>
        <!-- 本插件契约 -->
        <dependency>
            <groupId>com.babylog</groupId>
            <artifactId>babylog-plugin-biz-api</artifactId>
        </dependency>

        <!-- 底座契约与 Starter -->
        <dependency>
            <groupId>com.babylog</groupId>
            <artifactId>babylog-starter-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.babylog</groupId>
            <artifactId>babylog-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.babylog</groupId>
            <artifactId>babylog-starter-mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.babylog</groupId>
            <artifactId>babylog-starter-auth</artifactId>
        </dependency>
        <!-- 验证码/refresh token 存 Redis（starter-redis 带 redisson + StringRedisTemplate 自动装配） -->
        <dependency>
            <groupId>com.babylog</groupId>
            <artifactId>babylog-starter-redis</artifactId>
        </dependency>
        <!-- 跨插件只碰契约：sys_user 账号体系（错误码 2001/2002/2003 与 /app/auth/login 口径一致） -->
        <dependency>
            <groupId>com.babylog</groupId>
            <artifactId>babylog-plugin-system-api</artifactId>
        </dependency>

        <!-- SMTP 发信（spring.mail.* 配置齐全时 Boot 才装配 JavaMailSender，未配则发码端点返回 8374） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <!-- BCrypt 密码哈希（与 system 插件同款，BOM 已仲裁） -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
        </dependency>

        <!-- K2/M69 媒体存储：与 babylog-plugin-file 的 S3CompatibleStorageStrategy 同一个
             software.amazon.awssdk:s3（BOM 已仲裁 aws-sdk-v2 2.49.3），非新 SDK；
             biz 不能跨插件依赖 file 实现层（P0 ArchUnit C1），故在 media 垂直域自建字节流适配器 -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>
        <!-- K2/M69 淘汰任务：照既有 jobs 体例（MessageCleanupJob）用 @XxlJob + JobExecutionHelper，
             复用项目内 starter-job（非新 SDK）；AI 不启 xxl-job，启停交龙哥 -->
        <dependency>
            <groupId>com.babylog</groupId>
            <artifactId>babylog-starter-job</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 同步存储类型化改造的本地隔离集成测试（S3）：真实 MyBatis-Plus 链路 + 内存库，
             验证并发 upsert/墓碑/双游标分页/谓词过滤，不依赖外部 MySQL（版本以本地仓 1.4.197 为准） -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>1.4.197</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
